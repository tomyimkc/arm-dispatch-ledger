+// Dispatch counters: how many times a KleidiAI micro-kernel actually ran, by op path
+// and kernel family. The init-time selection log ("primary ... kernel feature ...")
+// reports what was chosen; these report what executed — the two can differ (e.g. a
+// weight placed in a non-KleidiAI buffer type never reaches these kernels at all).
+// Counting is always on (one relaxed atomic add per micro-kernel invocation); the
+// summary is printed at process exit only when GGML_KLEIDIAI_SUMMARY=1.
+enum kleidiai_dispatch_path {
+    KLEIDIAI_DISPATCH_PATH_F32 = 0,
+    KLEIDIAI_DISPATCH_PATH_FP16,
+    KLEIDIAI_DISPATCH_PATH_QX_GEMM,
+    KLEIDIAI_DISPATCH_PATH_QX_GEMV,
+    KLEIDIAI_DISPATCH_PATH_COUNT,
+};
+
+static const int KLEIDIAI_DISPATCH_FAMILY_COUNT = 6;
+
+static const char * kleidiai_dispatch_path_names[KLEIDIAI_DISPATCH_PATH_COUNT] = {
+    "f32", "fp16", "qx_gemm", "qx_gemv",
+};
+
+static const char * kleidiai_dispatch_family_names[KLEIDIAI_DISPATCH_FAMILY_COUNT] = {
+    "SME2", "SME", "SVE", "I8MM", "DOTPROD", "OTHER",
+};
+
+static std::atomic<uint64_t> kleidiai_dispatch_counts[KLEIDIAI_DISPATCH_PATH_COUNT][KLEIDIAI_DISPATCH_FAMILY_COUNT] = {};
+
+static int kleidiai_dispatch_family_index(cpu_feature f) {
+    // Mirrors cpu_feature_to_string's precedence.
+    if ((f & CPU_FEATURE_SME2) == CPU_FEATURE_SME2) {
+        return 0;
+    } else if ((f & CPU_FEATURE_SME) == CPU_FEATURE_SME) {
+        return 1;
+    } else if ((f & CPU_FEATURE_SVE) == CPU_FEATURE_SVE) {
+        return 2;
+    } else if ((f & CPU_FEATURE_I8MM) == CPU_FEATURE_I8MM) {
+        return 3;
+    } else if ((f & CPU_FEATURE_DOTPROD) == CPU_FEATURE_DOTPROD) {
+        return 4;
+    }
+    return 5;
+}
+
+static inline void kleidiai_dispatch_count_add(kleidiai_dispatch_path path, cpu_feature f) {
+    kleidiai_dispatch_counts[path][kleidiai_dispatch_family_index(f)].fetch_add(1, std::memory_order_relaxed);
+}
+
+static void kleidiai_print_dispatch_summary(void) {
+    GGML_LOG_INFO("kleidiai: dispatch summary: selected q4=%s q8=%s f32=%s\n",
+                  ctx.kernels_q4  ? cpu_feature_to_string(ctx.kernels_q4->required_cpu)  : "none",
+                  ctx.kernels_q8  ? cpu_feature_to_string(ctx.kernels_q8->required_cpu)  : "none",
+                  ctx.kernels_f32 ? cpu_feature_to_string(ctx.kernels_f32->required_cpu) : "none");
+
+    uint64_t total = 0;
+    for (int p = 0; p < KLEIDIAI_DISPATCH_PATH_COUNT; ++p) {
+        for (int f = 0; f < KLEIDIAI_DISPATCH_FAMILY_COUNT; ++f) {
+            const uint64_t n = kleidiai_dispatch_counts[p][f].load(std::memory_order_relaxed);
+            if (n > 0) {
+                GGML_LOG_INFO("kleidiai: dispatch summary: executed %s/%s=%llu\n",
+                              kleidiai_dispatch_path_names[p], kleidiai_dispatch_family_names[f],
+                              (unsigned long long) n);
+            }
+            total += n;
+        }
+    }
+    GGML_LOG_INFO("kleidiai: dispatch summary: executed total=%llu\n", (unsigned long long) total);
+}
+
+uint64_t ggml_backend_cpu_kleidiai_dispatch_total(void) {
+    uint64_t total = 0;
+    for (int p = 0; p < KLEIDIAI_DISPATCH_PATH_COUNT; ++p) {
+        for (int f = 0; f < KLEIDIAI_DISPATCH_FAMILY_COUNT; ++f) {
+            total += kleidiai_dispatch_counts[p][f].load(std::memory_order_relaxed);
+        }
+    }
+    return total;
+}
