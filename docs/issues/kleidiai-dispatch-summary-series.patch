diff --git a/tests/test-kleidiai-dispatch.cpp b/tests/test-kleidiai-dispatch.cpp
new file mode 100644
index 000000000..e769d3012
--- /dev/null
+++ b/tests/test-kleidiai-dispatch.cpp
@@ -0,0 +1,146 @@
+// Fail-closed check that the KleidiAI CPU extra buffer type actually executes its
+// micro-kernels for weights it accepted.
+//
+// Every static and log-level signal about KleidiAI (the KLEIDIAI = 1 build flag, the
+// init-time "primary ... kernel feature" selection log) reports capability or selection,
+// not execution. A measured field defect (ggml-org/llama.cpp issues #26547 / #26630 and
+// the CUDA-host-buffer priority variant) showed configurations where all of those
+// signals claim acceleration while zero KleidiAI kernels run. This test pins the
+// contract at the ggml level: if the KleidiAI buffer type accepts and packs a Q4_0
+// weight, computing a MUL_MAT against it must advance the KleidiAI dispatch counter.
+//
+// If the buffer type declines the weight (unsupported CPU), that is a visible,
+// non-conflatable outcome and the test skips.
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+// Internal diagnostics hook, declared in ggml/src/ggml-cpu/kleidiai/kleidiai.h (not a
+// public header). Declared locally here to keep the hook out of the public API.
+extern "C" ggml_backend_buffer_type_t ggml_backend_cpu_kleidiai_buffer_type(void);
+extern "C" uint64_t ggml_backend_cpu_kleidiai_dispatch_total(void);
+
+static void fill_q4_0(struct ggml_tensor * tensor, std::mt19937 & gen) {
+    const int64_t n_per_row = tensor->ne[0];
+    const int64_t nrows     = ggml_nrows(tensor);
+
+    std::normal_distribution<float> dis(0.0f, 1.0f);
+    std::vector<float> src((size_t) n_per_row * nrows);
+    for (size_t i = 0; i < src.size(); i++) {
+        src[i] = dis(gen);
+    }
+
+    std::vector<uint8_t> quantized(ggml_nbytes(tensor));
+    ggml_quantize_chunk(GGML_TYPE_Q4_0, src.data(), quantized.data(), 0, nrows, n_per_row, nullptr);
+
+    ggml_backend_tensor_set(tensor, quantized.data(), 0, quantized.size());
+}
+
+static void fill_f32(struct ggml_tensor * tensor, std::mt19937 & gen) {
+    std::normal_distribution<float> dis(0.0f, 1.0f);
+    std::vector<float> src(ggml_nelements(tensor));
+    for (size_t i = 0; i < src.size(); i++) {
+        src[i] = dis(gen);
+    }
+    ggml_backend_tensor_set(tensor, src.data(), 0, ggml_nbytes(tensor));
+}
+
+// Computes mul_mat(weight, activation[k, n_batch]) on the CPU backend and returns how
+// far the KleidiAI dispatch counter advanced.
+static uint64_t run_mul_mat_case(ggml_backend_t backend, struct ggml_tensor * weight, int64_t n_batch, std::mt19937 & gen) {
+    const int64_t k = weight->ne[0];
+
+    struct ggml_init_params params = {
+        /* .mem_size   = */ ggml_tensor_overhead() * 8 + ggml_graph_overhead(),
+        /* .mem_buffer = */ nullptr,
+        /* .no_alloc   = */ true,
+    };
+    struct ggml_context * ctx = ggml_init(params);
+
+    struct ggml_tensor * act = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n_batch);
+    struct ggml_tensor * out = ggml_mul_mat(ctx, weight, act);
+
+    struct ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, out);
+
+    ggml_gallocr_t galloc = ggml_gallocr_new(ggml_backend_cpu_buffer_type());
+    if (!ggml_gallocr_alloc_graph(galloc, gf)) {
+        fprintf(stderr, "%s: failed to allocate graph\n", __func__);
+        exit(1);
+    }
+
+    fill_f32(act, gen);
+
+    const uint64_t before = ggml_backend_cpu_kleidiai_dispatch_total();
+    if (ggml_backend_graph_compute(backend, gf) != GGML_STATUS_SUCCESS) {
+        fprintf(stderr, "%s: graph compute failed\n", __func__);
+        exit(1);
+    }
+    const uint64_t after = ggml_backend_cpu_kleidiai_dispatch_total();
+
+    ggml_gallocr_free(galloc);
+    ggml_free(ctx);
+
+    return after - before;
+}
+
+int main(void) {
+    const int64_t k = 256; // multiple of QK4_0
+    const int64_t n = 256;
+
+    struct ggml_init_params params = {
+        /* .mem_size   = */ ggml_tensor_overhead() * 2,
+        /* .mem_buffer = */ nullptr,
+        /* .no_alloc   = */ true,
+    };
+    struct ggml_context * ctx_w = ggml_init(params);
+
+    struct ggml_tensor * weight = ggml_new_tensor_2d(ctx_w, GGML_TYPE_Q4_0, k, n);
+
+    ggml_backend_buffer_t buf_w = ggml_backend_alloc_ctx_tensors_from_buft(ctx_w, ggml_backend_cpu_kleidiai_buffer_type());
+    if (buf_w == nullptr) {
+        // The buffer type declined the weight: no kernel for this CPU. That is a
+        // visible outcome, not a silent conflation - nothing to verify here.
+        printf("KleidiAI buffer type declined the Q4_0 weight on this CPU - skipping\n");
+        ggml_free(ctx_w);
+        return 0;
+    }
+
+    std::mt19937 gen(42);
+    fill_q4_0(weight, gen);
+
+    ggml_backend_t backend = ggml_backend_cpu_init();
+    ggml_backend_cpu_set_n_threads(backend, 2);
+
+    int n_failed = 0;
+    const int64_t batch_sizes[2] = { 1, 8 }; // gemv (decode-shaped) and gemm (prefill-shaped)
+    for (int i = 0; i < 2; i++) {
+        const uint64_t n_dispatched = run_mul_mat_case(backend, weight, batch_sizes[i], gen);
+        const bool ok = n_dispatched > 0;
+        printf("mul_mat [%" PRId64 " x %" PRId64 "] * [%" PRId64 " x %" PRId64 "]: %" PRIu64 " KleidiAI kernel invocations - %s\n",
+               k, n, k, batch_sizes[i], n_dispatched, ok ? "OK" : "FAIL");
+        if (!ok) {
+            n_failed++;
+        }
+    }
+
+    ggml_backend_free(backend);
+    ggml_backend_buffer_free(buf_w);
+    ggml_free(ctx_w);
+
+    if (n_failed > 0) {
+        fprintf(stderr, "FAIL: the KleidiAI buffer type accepted the weight but executed zero micro-kernels\n");
+        return 1;
+    }
+
+    printf("OK\n");
+    return 0;
+}
